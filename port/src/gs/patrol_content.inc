    {
     "speaker": "enemy",
     "text": "We were the Demon King's ambition. We were Frieza's first murder. We were the hunger in a little pink thing that ate the Kais.",
     "effects": [
      "aura_on"
     ]
    },
    {
     "speaker": "narrator",
     "text": "Super Janemba speaks in a thousand overlapping voices. Every one of them belongs to someone who once regretted something."
    },
    {
     "speaker": "enemy",
     "text": "Show us your worst day, empty one."
    },
    {
     "speaker": "player",
     "text": "Sorry. I'm new here."
    },
    {
     "speaker": "enemy",
     "text": "Then we will give you one. And we will make it last forever.",
     "effects": [
      "charge_on",
      "big_shake"
     ],
     "camera": "low"
    }
   ],
   "win": [
